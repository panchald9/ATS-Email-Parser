# Streamlit Cloud Secrets Configuration
# This file is used to store secrets for Streamlit Cloud deployment
# DO NOT commit this file to git - it will be created in Streamlit Cloud dashboard

# API Configuration for Streamlit Cloud
api_key = "your-api-key-here"
api_url = "https://your-api-url-here"

# Optional: Database credentials if needed
# db_host = "your-db-host"
# db_user = "your-db-user"
# db_password = "your-db-password"
