# Resume Parser Environment Configuration
# Copy this file to .env and fill in values for production

# ──────────────────────────────────────────────────────────
# API Configuration
# ──────────────────────────────────────────────────────────
API_KEY=dev-secret-key
API_URL=http://localhost:8000
HOST=0.0.0.0
PORT=8000
ENV=development

# ──────────────────────────────────────────────────────────
# Streamlit Configuration
# ──────────────────────────────────────────────────────────
STREAMLIT_PORT=8501
STREAMLIT_SERVER_HEADLESS=false

# ──────────────────────────────────────────────────────────
# Security
# ──────────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8501
TRUSTED_HOSTS=localhost,127.0.0.1

# ──────────────────────────────────────────────────────────
# Rate Limiting
# ──────────────────────────────────────────────────────────
RATE_LIMIT_PER_MINUTE=30
MAX_UPLOAD_MB=10

# ──────────────────────────────────────────────────────────
# Resume Parser Configuration
# ──────────────────────────────────────────────────────────
RESUME_FOLDER=./Resume
SKILLS_CSV=./src/Skill.csv
EDUCATION_CSV=./src/03_education.csv
OUTPUT_JSON=./src/output/resume_parsed.json
VALIDATION_JSON=./src/output/validation_report.json

# ──────────────────────────────────────────────────────────
# Logging
# ──────────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FILE=./src/output/parser.log
ENABLE_DETAILED_LOGGING=false
